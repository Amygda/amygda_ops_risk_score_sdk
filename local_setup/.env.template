# ─── LLM provider ─────────────────────────────────────────────────────────────
# Choose one provider and fill in the matching key. Leave the other commented out.

LLM_PROVIDER=openai
LLM_MODEL=gpt-6.1-sol             # Supported model. Others (e.g. gpt-4o) fail: the API requests up to 64k output tokens.
OPENAI_API_KEY=sk-...              # No quotes. Paste the key value directly.

# Anthropic alternative — uncomment these three and comment out the three above:
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-4-5     # claude-3-5-haiku-20241022 is cheaper but slower
# ANTHROPIC_API_KEY=sk-ant-...

# ─── API storage — do not change the /data/... paths ──────────────────────────
# These are container-internal paths. The folder on YOUR machine is set by LOCAL_DATA_DIR below.
# Changing /data/storage or /data/db here will break the startup script.

STORAGE_ROOT=/data/storage                                # where session artefacts are written inside the container
DATABASE_URL=sqlite+aiosqlite:////data/db/labelling.db    # SQLite DB path inside the container

# ─── API session limits ────────────────────────────────────────────────────────

SESSION_EXPIRY_MINUTES=360        # How long a session stays alive without activity (minutes). Default 6 h.
                                  # Must be higher than the longest pipeline run you expect.

MAX_FILE_SIZE_MB=100              # Maximum upload size per session (MB).

DOWNSAMPLE_THRESHOLD=13000        # If a dataset has more rows than this, it is randomly downsampled
                                  # before classification to keep runtime reasonable.
                                  # Raise this if your data is large and you want full coverage (slower).

# ─── Volume paths — host-side only ────────────────────────────────────────────
# These control WHERE on your machine Docker stores the data.
# The container always sees it at /data regardless of what you set here.

LOCAL_DATA_DIR=./data             # Change to any path on your machine, e.g. /home/user/ops-data.
                                  # Docker creates the folder if it does not exist.
                                  # WARNING: deleting this folder removes the database and all session data.

# ─── Streamlit ────────────────────────────────────────────────────────────────

TRAINED_MODELS_DIR=./trained_models   # Path on your machine to the trained_models folder
                                      # (produced by the Data Labelling page).
                                      # Change to any path; the container always sees it at /data/trained_models.
